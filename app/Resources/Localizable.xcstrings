    "Nothing on your Mac is changed permanently. macOS reconnects its own service when you disconnect.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing on your Mac is changed permanently. macOS reconnects its own service when you disconnect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se cambia nada de forma permanente en tu Mac. macOS vuelve a conectar su propio servicio cuando desconectas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac に恒久的な変更は加えられません。接続を解除すると、macOS は自身のサービスを再接続します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На вашем Mac ничего не меняется навсегда. При отключении macOS снова подключает свою службу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不会对你的 Mac 做出任何永久性更改。断开连接后，macOS 会重新接管其自身服务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不會對你的 Mac 做出任何永久性變更。中斷連線後，macOS 會重新接管其自身服務。"
          }
        }
      }
    },
