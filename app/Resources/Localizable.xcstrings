    "Paste the report into a bug report. It lists USB devices, any process holding the USB interface, and the connected device's capabilities.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste the report into a bug report. It lists USB devices, any process holding the USB interface, and the connected device's capabilities."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega el informe en el reporte de error. Incluye los dispositivos USB, cualquier proceso que retenga la interfaz USB y las capacidades del dispositivo conectado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このレポートを不具合報告に貼り付けてください。USB デバイス、USB インターフェイスを占有しているプロセス、接続中のデバイスの対応機能が含まれます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставьте отчёт в сообщение об ошибке. В нём перечислены USB-устройства, процессы, удерживающие USB-интерфейс, и возможности подключённого устройства."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将报告粘贴到错误报告中。其中列出了 USB 设备、占用 USB 接口的进程，以及已连接设备的功能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將報告貼到錯誤報告中。其中列出了 USB 裝置、佔用 USB 介面的程序，以及已連接裝置的功能。"
          }
        }
      }
    },
