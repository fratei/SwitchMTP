      }
    },
    "The Saves storage is read-only on this device. Enable save write access in DBI, then reconnect.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Saves storage is read-only on this device. Enable save write access in DBI, then reconnect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El almacenamiento de partidas es de solo lectura en este dispositivo. Activa el acceso de escritura a partidas en DBI y vuelve a conectar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスでは Saves ストレージが読み取り専用です。DBI でセーブデータへの書き込みを有効にしてから、接続し直してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хранилище сохранений на этом устройстве доступно только для чтения. Включите запись сохранений в DBI и переподключитесь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备上的存档存储为只读。请在 DBI 中启用存档写入权限，然后重新连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置上的存檔儲存空間為唯讀。請在 DBI 中啟用存檔寫入權限，然後重新連接。"
          }
        }
      }
    },
    "The console can only do one thing at a time over USB, so it cannot list a folder while it is copying. SwitchMTP will open this folder as soon as the transfer is done.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The console can only do one thing at a time over USB, so it cannot list a folder while it is copying. SwitchMTP will open this folder as soon as the transfer is done."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La consola solo puede hacer una cosa a la vez por USB, así que no puede mostrar una carpeta mientras copia. SwitchMTP abrirá esta carpeta en cuanto termine la transferencia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本体は USB 経由で一度に 1 つの処理しか行えないため、コピー中はフォルダを一覧表示できません。転送が完了次第、SwitchMTP がこのフォルダを開きます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Консоль может выполнять только одну операцию по USB за раз, поэтому она не может показать папку во время копирования. SwitchMTP откроет эту папку сразу после завершения передачи."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主机通过 USB 一次只能执行一项操作，因此在复制时无法列出文件夹。传输完成后，SwitchMTP 将立即打开此文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "主機透過 USB 一次只能執行一項操作，因此在複製時無法列出資料夾。傳輸完成後，SwitchMTP 會立即開啟此資料夾。"
          }
        }
      }
    },
