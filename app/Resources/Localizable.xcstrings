    "No administrator password and no special permissions are needed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No administrator password and no special permissions are needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se necesita contraseña de administrador ni permisos especiales."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "管理者パスワードや特別な権限は必要ありません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не требуется ни пароль администратора, ни особые разрешения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需管理员密码，也不需要任何特殊权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不需要管理者密碼，也不需要任何特殊權限。"
          }
        }
      }
    },
    "No apps or processes are ever quit or force-quit.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No apps or processes are ever quit or force-quit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca se cierra ni se fuerza el cierre de ninguna aplicación ni proceso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリやプロセスを終了または強制終了することは一切ありません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Никакие приложения или процессы никогда не завершаются, в том числе принудительно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绝不会退出或强制退出任何应用或进程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "絕不會結束或強制結束任何 App 或程序。"
          }
        }
      }
    },
    "No console found. Check the cable, then launch DBI and choose \"Run MTP responder\".": {
      "comment": "Shown when Connect is pressed with no device attached",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No console found. Check the cable, then launch DBI and choose \"Run MTP responder\"."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha encontrado ninguna consola. Comprueba el cable y luego abre DBI y elige \"Run MTP responder\"."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本体が見つかりません。ケーブルを確認してから DBI を起動し、「Run MTP responder」を選んでください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Консоль не найдена. Проверьте кабель, затем запустите DBI и выберите «Run MTP responder»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到主机。请检查数据线，然后启动 DBI 并选择“Run MTP responder”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到主機。請檢查傳輸線，然後啟動 DBI 並選擇「Run MTP responder」。"
          }
        }
      }
    },
