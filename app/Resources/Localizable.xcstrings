    "%@ is no longer readable. It may have been moved, renamed or ejected.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is no longer readable. It may have been moved, renamed or ejected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya no se puede leer %@. Puede que se haya movido, renombrado o expulsado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を読み取れなくなりました。移動、名前変更、または取り出しが行われた可能性があります。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл %@ больше не читается. Возможно, он был перемещён, переименован или извлечён."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法再读取 %@。它可能已被移动、重命名或弹出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法再讀取 %@。它可能已被移動、重新命名或退出。"
          }
        }
      }
    },
    "%@ — contents are generated by DBI on demand and cannot be changed.": {
      "comment": "Tooltip for a virtual storage in the sidebar",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — contents are generated by DBI on demand and cannot be changed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: DBI genera el contenido bajo demanda y no se puede modificar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — 内容は DBI がその都度生成するため、変更できません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — содержимое создаётся DBI по запросу и не может быть изменено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — 内容由 DBI 按需生成，无法更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — 內容由 DBI 隨選產生，無法更改。"
          }
        }
      }
    },
    "%@ — read-only. You can browse and download, but not change anything.": {
      "comment": "Tooltip for a read-only storage in the sidebar",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — read-only. You can browse and download, but not change anything."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: solo lectura. Puedes explorar y descargar, pero no modificar nada."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — 読み取り専用です。閲覧とダウンロードはできますが、変更はできません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — только чтение. Можно просматривать и скачивать, но не изменять."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — 只读。可以浏览和下载，但无法更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — 唯讀。可以瀏覽和下載，但無法更改。"
          }
        }
      }
    },
    "%@ — you can browse, download and upload here.": {
      "comment": "Tooltip for a writable storage in the sidebar",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — you can browse, download and upload here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: aquí puedes explorar, descargar y subir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — 閲覧・ダウンロード・アップロードができます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — здесь можно просматривать, скачивать и загружать файлы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — 可在此浏览、下载和上传。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — 可在此瀏覽、下載和上傳。"
          }
        }
      }
    },
