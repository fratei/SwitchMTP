    "Only the port your Switch is plugged into is reset. Other USB devices are untouched.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the port your Switch is plugged into is reset. Other USB devices are untouched."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se reinicia el puerto al que está conectada tu Switch. Los demás dispositivos USB no se ven afectados."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リセットされるのは Switch が接続されているポートだけです。他の USB デバイスには影響しません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сбрасывается только порт, к которому подключена ваша Switch. Другие USB-устройства не затрагиваются."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只会重置 Switch 所连接的端口，其他 USB 设备不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只會重設 Switch 所連接的埠，其他 USB 裝置不受影響。"
          }
        }
      }
