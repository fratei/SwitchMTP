    "Files in “%@” will replace save data on the console. This cannot be undone. Back up your current saves first if you have not already.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files in “%@” will replace save data on the console. This cannot be undone. Back up your current saves first if you have not already."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos de «%@» reemplazarán las partidas guardadas de la consola. Esta acción no se puede deshacer. Haz antes una copia de seguridad si aún no la tienes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」内のファイルが本体のセーブデータを置き換えます。この操作は取り消せません。まだの場合は、先に現在のセーブデータをバックアップしてください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы из «%@» заменят сохранения на консоли. Это действие нельзя отменить. Сначала создайте резервную копию текущих сохранений, если вы этого ещё не сделали."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”中的文件将替换主机上的存档数据。此操作无法撤销。如果尚未备份，请先备份当前存档。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」中的檔案將取代主機上的存檔資料。此操作無法復原。若尚未備份，請先備份目前的存檔。"
          }
        }
      }
    },
