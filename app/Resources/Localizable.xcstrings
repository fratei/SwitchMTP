    "That install storage is no longer available. Reconnect the console and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That install storage is no longer available. Reconnect the console and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese almacenamiento de instalación ya no está disponible. Vuelve a conectar la consola e inténtalo de nuevo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのインストール先ストレージは利用できなくなりました。本体を接続し直してからもう一度お試しください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это хранилище для установки больше недоступно. Переподключите консоль и повторите попытку."
          }
        },
        "zh-Hans": {
