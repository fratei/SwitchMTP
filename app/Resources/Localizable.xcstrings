    "No progress for %llds. The console may be busy; DBI shows the real state on screen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No progress for %llds. The console may be busy; DBI shows the real state on screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin progreso durante %llds. Puede que la consola esté ocupada; DBI muestra el estado real en pantalla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 秒間、進行がありません。本体が処理中の可能性があります。実際の状態は DBI の画面に表示されます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет прогресса уже %lld с. Возможно, консоль занята; реальное состояние показывает DBI на экране."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有 %lld 秒没有进度。主机可能正忙；DBI 会在屏幕上显示真实状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已有 %lld 秒沒有進度。主機可能正忙；DBI 會在螢幕上顯示真實狀態。"
          }
        }
      }
    },
    "No progress reported yet. The console may still be preparing — DBI shows the real state on screen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No progress reported yet. The console may still be preparing — DBI shows the real state on screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no se ha informado de ningún progreso. Puede que la consola siga preparándose: DBI muestra el estado real en pantalla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ進行状況が報告されていません。本体が準備中の可能性があります。実際の状態は DBI の画面に表示されます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прогресс пока не сообщается. Возможно, консоль ещё готовится — реальное состояние показывает DBI на экране."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未报告进度。主机可能仍在准备中——DBI 会在屏幕上显示真实状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未回報進度。主機可能仍在準備中——DBI 會在螢幕上顯示真實狀態。"
          }
        }
      }
    },
